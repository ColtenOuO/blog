---
import { NAV, SITE } from '../config';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href) || (href === '/category/notes' && /\/category\/(travel|life)/.test(path));
---

<header class="site-header">
  <div class="container inner">
    <a href="/" class="brand">{SITE.title}</a>
    <nav>
      {
        NAV.map((item) => (
          <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))
      }
      <button id="theme-toggle" class="theme" aria-label="切換深色模式" title="切換深色模式">
        <svg class="sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path></svg
        >
        <svg class="moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8"
          ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg
        >
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    min-height: 60px;
    flex-wrap: wrap;
  }
  .brand {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.15rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .brand:hover {
    color: var(--text);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 2px 22px;
    flex-wrap: wrap;
  }
  .nav-link {
    color: var(--text-muted);
    font-size: 0.95rem;
    text-decoration: none;
    padding: 4px 0;
    border-bottom: 2px solid transparent;
  }
  .nav-link:hover {
    color: var(--text);
  }
  .nav-link.active {
    color: var(--text);
    border-bottom-color: var(--accent);
  }
  .theme {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: none;
    background: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0;
  }
  .theme:hover {
    color: var(--text);
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .moon {
    display: block;
  }
  @media (max-width: 560px) {
    .inner {
      padding-top: 10px;
      padding-bottom: 8px;
    }
    nav {
      gap: 2px 16px;
    }
  }
</style>
