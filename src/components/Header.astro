---
import { NAV, SITE } from '../config';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/'
    ? path === '/'
    : path.startsWith(href) ||
      (href === '/category/notes' && /\/category\/(travel|life)/.test(path)) ||
      // 開放式課程放在教學底下
      (href === '/category/tutorial' && path.startsWith('/courses'));
---

<header class="site-header">
  <div class="container inner">
    <a href="/" class="brand">{SITE.title}</a>
    <nav>
      {
        NAV.map((item) => (
          <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>


<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    min-height: 60px;
    flex-wrap: wrap;
  }
  .brand {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.15rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .brand:hover {
    color: var(--text);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 2px 22px;
    flex-wrap: wrap;
  }
  .nav-link {
    color: var(--text-muted);
    font-size: 0.95rem;
    text-decoration: none;
    padding: 4px 0;
    border-bottom: 2px solid transparent;
  }
  .nav-link:hover {
    color: var(--text);
  }
  .nav-link.active {
    color: var(--text);
    border-bottom-color: var(--accent);
  }
  @media (max-width: 560px) {
    .inner {
      padding-top: 10px;
      padding-bottom: 8px;
    }
    nav {
      gap: 2px 16px;
    }
  }
</style>
