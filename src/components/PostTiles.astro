---
// 文章列表（圖片網格）：給旅遊與雜記用
import { Image } from 'astro:assets';
import { CATEGORIES } from '../config';
import { formatDate, postUrl, type Post } from '../utils/posts';

interface Props {
  posts: Post[];
  columns?: 2 | 3;
  empty?: string;
}
const { posts, columns = 3, empty = '還沒有文章。' } = Astro.props;
---

{
  posts.length ? (
    <div class="tiles" style={`--cols:${columns}`}>
      {posts.map((p) => (
        <a class="tile" href={postUrl(p)}>
          {p.data.cover ? (
            <Image src={p.data.cover} alt="" width={640} class="cover" />
          ) : (
            <div class="cover none" />
          )}
          <span class="meta mono muted">
            <b style={`color:${CATEGORIES[p.data.category].color}`}>{CATEGORIES[p.data.category].label}</b> · {formatDate(p.data.date)}
            <span class="views" data-views={p.id} />
          </span>
          <span class="title">{p.data.title}</span>
          {p.data.description && <span class="desc">{p.data.description}</span>}
        </a>
      ))}
    </div>
  ) : (
    <p class="muted">{empty}</p>
  )
}

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 32px 24px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }
  .cover {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 10px;
    transition: opacity 0.2s;
  }
  .cover.none {
    background:
      repeating-linear-gradient(-45deg, transparent 0 10px, var(--rule) 10px 11px),
      var(--surface);
    border: 1px solid var(--rule);
  }
  .tile:hover .cover {
    opacity: 0.85;
  }
  .views:not(:empty)::before {
    content: ' · ';
  }
  .title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.08rem;
    line-height: 1.45;
    margin-top: 2px;
  }
  .tile:hover .title {
    color: var(--accent);
  }
  .desc {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-top: 4px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 820px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .tiles {
      grid-template-columns: 1fr;
    }
  }
</style>
