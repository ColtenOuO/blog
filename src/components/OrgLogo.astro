---
// 組織 Logo：對應 src/assets/logos/<logo>.(png|jpg|svg)
// 沒有 logo 時顯示一個彩色圖示（icon 可指定：trophy / code / people / school / book / star）
import { Image } from 'astro:assets';
import type { Icon } from '../data';

interface Props {
  logo?: string | string[]; // 可給多個候選，用第一個找得到的
  name: string;
  size?: number;
  icon?: Icon;
}
const { logo, name, size = 40, icon = 'star' } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/logos/*.{png,jpg,jpeg,svg,webp}', {
  eager: true,
});
const byName = new Map(Object.entries(files).map(([p, m]) => [p.split('/').pop()!.replace(/\.[^.]+$/, ''), m.default]));
const match = [logo ?? []].flat().map((n) => byName.get(n)).find(Boolean);

const palette = ['--c-orange', '--c-blue', '--c-green', '--c-pink', '--c-purple'];
const hash = [...name].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const color = `var(${palette[hash % palette.length]})`;

// Lucide 風格的線條圖示
const ICONS: Record<Icon, string> = {
  trophy:
    '<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4z"/><path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3"/>',
  code: '<path d="m16 18 6-6-6-6M8 6l-6 6 6 6M14 4l-4 16"/>',
  people:
    '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5a6.5 6.5 0 0 1 3.5 5.5"/>',
  school: '<path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c3 2 9 2 12 0v-5"/>',
  book: '<path d="M4 19.5V5a2 2 0 0 1 2-2h14v16H6a2 2 0 0 0-2 2.5zM4 19.5A2.5 2.5 0 0 0 6.5 22H20"/>',
  star: '<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>',
};
---

{
  match ? (
    <span class="logo" style={`--s:${size}px`}>
      <Image src={match} alt="" width={size * 2} height={size * 2} />
    </span>
  ) : (
    <span class="logo icon-tile" style={`--s:${size}px;--ic:${color}`} aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={ICONS[icon]}
      />
    </span>
  )
}

<style>
  .logo {
    flex: 0 0 var(--s);
    width: var(--s);
    height: var(--s);
    border-radius: 10px;
    background: #fff;
    border: 1px solid var(--rule);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .logo img {
    width: 82%;
    height: 82%;
    object-fit: contain;
  }
  .icon-tile {
    color: var(--ic);
    border-color: color-mix(in srgb, var(--ic) 30%, transparent);
    background:
      radial-gradient(circle at 30% 25%, color-mix(in srgb, var(--ic) 22%, transparent), transparent 70%),
      color-mix(in srgb, var(--ic) 10%, var(--surface));
  }
  .icon-tile svg {
    width: 52%;
    height: 52%;
  }
</style>
