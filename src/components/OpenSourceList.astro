---
// 開源貢獻：每個 repo 一列，點擊連到自己在該 repo 的 merged PR 列表
import OrgLogo from './OrgLogo.astro';
import { OPEN_SOURCE } from '../data';
import { GITHUB_USER, getGithubCounts, mergedPrsUrl, reviewedPrsUrl } from '../utils/github';

interface Props {
  compact?: boolean;
  limit?: number;
}
const { compact = false, limit } = Astro.props;
const live = await getGithubCounts();
const all = OPEN_SOURCE.map((r) => ({
  ...r,
  merged: live?.merged[r.repo] ?? r.merged,
  reviewed: live?.reviewed[r.repo] ?? r.reviewed,
  href: r.href ?? mergedPrsUrl(r.repo),
})).sort((a, b) => b.merged - a.merged);
const repos = all.slice(0, limit);
// 沒指定 logo 時，依序找 src/assets/logos/ 裡的 <repo 名稱>、<組織名稱>
// 例如 apache/airflow → airflow.png，找不到再用 apache.png
function logoCandidates(r: { repo: string; logo?: string }) {
  const [owner, name] = r.repo.split('/');
  return [r.logo, name, owner].filter(Boolean) as string[];
}
// 總覽：所有列出的專案加總
const stats = [
  { value: all.reduce((s, r) => s + r.merged, 0), label: 'Merged PRs / patches', zh: '被合併' },
  { value: all.reduce((s, r) => s + r.reviewed, 0), label: 'Reviewed PRs', zh: 'Review 過' },
  { value: all.length, label: 'Projects', zh: '參與專案' },
];
---

<div class="os">
  {
    !compact && (
      <a class="overview" href={`https://github.com/${GITHUB_USER}`} target="_blank" rel="noopener">
        {stats.map((st) => (
          <div class="stat">
            <b>{st.value}</b>
            <span class="zh">{st.zh}</span>
            <span class="mono muted">{st.label}</span>
          </div>
        ))}
        <div class="stat gh">
          <svg viewBox="0 0 16 16" width="34" height="34" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          <span class="mono muted">@{GITHUB_USER} ↗</span>
        </div>
      </a>
    )
  }
  <ul>
    {
      repos.map((r) => (
        <li>
          <OrgLogo logo={logoCandidates(r)} name={r.repo} size={34} icon="code" />
          <div class="body">
            <a class="repo mono" href={r.href} target="_blank" rel="noopener">
              {r.repo}
            </a>
            {r.role && <span class="label green">{r.role}</span>}
            {!compact && r.about && <div class="about">{r.about}</div>}
            {!compact && r.note && <div class="note">{r.note}</div>}
            {!compact && r.links && (
              <div class="extra">
                {r.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener">
                    {l.label} ↗
                  </a>
                ))}
              </div>
            )}
            {!compact && r.highlights && (
              <ul class="prs">
                {r.highlights.map((h) => (
                  <li>
                    <a href={`https://github.com/${r.repo}/pull/${h.pr}`} target="_blank" rel="noopener">
                      <span class="mono">#{h.pr}</span> {h.title}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
          <div class="counts">
            <a class="count" href={r.href} target="_blank" rel="noopener">
              <b>{r.merged}</b>
              <span class="mono muted">{r.unit ?? 'merged'}</span>
            </a>
            {r.reviewed > 0 && (
              <a class="count reviewed" href={reviewedPrsUrl(r.repo)} target="_blank" rel="noopener">
                <b>{r.reviewed}</b>
                <span class="mono muted">reviewed</span>
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* flex-wrap + flex-grow：不管寬度怎麼換行，每一列的格子都會撐滿，不會留下空白格 */
  .overview {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    margin: 0 0 18px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }
  .stat {
    flex: 1 1 140px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 14px;
    background: var(--bg);
  }
  .stat b {
    font-family: var(--font-serif);
    font-size: 1.7rem;
    line-height: 1.1;
    color: var(--c-green);
  }
  .stat .zh {
    font-size: 0.9rem;
    font-weight: 600;
  }
  .stat .mono {
    font-size: 0.68rem;
  }
  .stat.gh {
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--text);
  }
  .overview:hover .stat.gh {
    color: var(--c-green);
  }
  .overview:hover .stat b {
    text-decoration: underline;
  }
  @media (max-width: 480px) {
    .stat {
      padding: 10px;
    }
    .stat b {
      font-size: 1.4rem;
    }
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .os > ul > li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }
  .os > ul > li:first-child {
    padding-top: 2px;
  }
  .body {
    flex: 1;
    min-width: 0;
    padding-top: 5px;
  }
  .repo {
    font-size: 0.9rem;
    text-decoration: none;
    font-weight: 500;
  }
  .about {
    font-size: 0.9rem;
    margin-top: 2px;
  }
  .note {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 2px;
  }
  .prs {
    margin-top: 6px;
    font-size: 0.88rem;
  }
  .prs li {
    padding: 2px 0;
  }
  .prs a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .prs a:hover {
    color: var(--accent);
  }
  .prs .mono {
    color: var(--c-green);
  }
  .extra {
    margin-top: 4px;
    font-size: 0.86rem;
  }
  .extra a {
    color: var(--c-green);
    text-decoration: none;
  }
  .repo + .label {
    margin-left: 8px;
  }
  .counts {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .count {
    display: flex;
    align-items: baseline;
    gap: 5px;
    margin-top: 3px;
    text-decoration: none;
  }
  .count b {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--c-green);
  }
  .count span {
    font-size: 0.72rem;
  }
  .count.reviewed b {
    font-size: 0.95rem;
    color: var(--c-purple);
  }
  .count:hover b {
    text-decoration: underline;
  }
</style>
