---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import PostRows from '../../components/PostRows.astro';
import { getPosts, type Post } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Set(posts.flatMap((p) => p.data.tags));
  return [...tags].map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props as { posts: Post[] };
---

<BaseLayout title={`#${tag}`}>
  <PageBanner title={`#${tag}`} en="Tag" subtitle={`${posts.length} 篇文章`}>
    <nav class="chips"><a class="chip" href="/tags/">← 所有標籤</a></nav>
  </PageBanner>
  <div class="narrow">
    <PostRows posts={posts} showCategory />
  </div>
</BaseLayout>

<style>
  .narrow {
    max-width: 780px;
  }
</style>
