---
// 研究頁：左欄研究方向與實驗室，右欄期刊 / 國際會議 / 國內會議論文
// 內容來自 src/data/publications.yaml；實驗室取 education.yaml 裡有填 lab 的學歷
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import OrgLogo from '../components/OrgLogo.astro';
import { DOMESTIC_CONFERENCES, EDUCATION, INTL_CONFERENCES, JOURNALS, PROFILE, RESEARCH_INTERESTS, RESEARCH_ME, type Publication } from '../data';

// prefix：編號前綴，J = 期刊、C = 國際會議、D = 國內會議
const groups: {
  key: 'journals' | 'intlConferences' | 'domesticConferences';
  items: Publication[];
  color: string;
  prefix: string;
  label: string;
}[] = [
  { key: 'journals', items: JOURNALS, color: 'c-blue', prefix: 'J', label: '期刊' },
  { key: 'intlConferences', items: INTL_CONFERENCES, color: 'c-purple', prefix: 'C', label: '國際會議' },
  { key: 'domesticConferences', items: DOMESTIC_CONFERENCES, color: 'c-green', prefix: 'D', label: '國內會議' },
];
const total = groups.reduce((n, g) => n + g.items.length, 0);
// 每個實驗室列一次（碩士班、博士班同一間只算一次），由新到舊
// 期間合併：最早那筆的開始 – 最新那筆的結束，例如碩士 2026.09 + 博士 2027.02 – → 2026.09 –
const withLab = EDUCATION.filter((e) => e.lab);
const labs = withLab
  .filter((e, i, all) => all.findIndex((x) => x.lab!.name === e.lab!.name) === i)
  .map((e) => {
    const same = withLab.filter((x) => x.lab!.name === e.lab!.name);
    const start = same[same.length - 1].period.split('–')[0].trim();
    const end = e.period.split('–')[1]?.trim() ?? '';
    return { ...e, period: `${start} – ${end}`.trim() };
  });

// 作者用「, 」或「、」分隔；自己的名字（publications.yaml 的 me）加粗並加上 *
const ME = new Set([PROFILE.name, ...RESEARCH_ME]);
const authorSep = (authors: string) => (authors.includes('、') ? '、' : ', ');
const authorParts = (authors: string) =>
  authors.split(/\s*[,、]\s*/).map((name) => ({ name, me: ME.has(name) }));
---

<BaseLayout title="研究" description={`${PROFILE.name} 的研究方向與論文發表`}>
  <header class="head">
    <h1 class="page-title">研究<span class="en">Research</span></h1>
    <p class="page-subtitle">研究方向與論文發表</p>
  </header>

  <div class="grid">
    <aside class="span-4 side">
      {
        RESEARCH_INTERESTS.length > 0 && (
          <section class="c-green">
            <h2 class="small-head">研究方向<span class="en">Interests</span></h2>
            <ul class="interests">
              {RESEARCH_INTERESTS.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </section>
        )
      }
      {
        labs.length > 0 && (
          <section class="c-orange">
            <h2 class="small-head">實驗室<span class="en">Lab</span></h2>
            <ul class="labs">
              {labs.map((e) => (
                <li class="lab">
                  <OrgLogo logo={[e.lab!.logo ?? '', e.logo ?? '']} name={e.lab!.name} size={42} icon="school" />
                  <div>
                    {e.lab!.url ? (
                      <a href={e.lab!.url} target="_blank" rel="noopener">
                        <strong>{e.lab!.name}</strong> ↗
                      </a>
                    ) : (
                      <strong>{e.lab!.name}</strong>
                    )}
                    <div class="muted">{e.school.replace(/\s*\(.*\)$/, '')}</div>
                    <div class="mono muted">{e.period}</div>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {
        total > 0 && (
          <section class="c-blue">
            <h2 class="small-head">發表統計<span class="en">Summary</span></h2>
            <dl class="stats">
              {groups.map((g) => (
                <div>
                  <dt class="mono">{g.items.length}</dt>
                  <dd>{g.label}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }
    </aside>

    <div class="span-8 pubs">
      {
        groups.map((g) => (
          <section class={g.color}>
            <SectionHead section={g.key} />
            {g.items.length ? (
              <ol class="list">
                {g.items.map((p, i) => (
                  <li>
                    <span class="idx mono">[{g.prefix}{g.items.length - i}]</span>
                    <div class="body">
                      <div class="title">{p.title}</div>
                      <div class="authors">
                        {authorParts(p.authors).map((a, j) => (
                          <>
                            {j > 0 && authorSep(p.authors)}
                            {a.me ? <strong>{a.name}*</strong> : a.name}
                          </>
                        ))}
                      </div>
                      <div class="venue">
                        <em>{p.venue}</em>
                        {p.year && <span class="mono">, {p.year}</span>}
                        {p.note && <span class="note">{p.note}</span>}
                      </div>
                      {p.links.length > 0 && (
                        <div class="links mono">
                          {p.links.map((l) => (
                            <a href={l.href} target="_blank" rel="noopener">
                              {l.label} ↗
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="empty muted">即將更新</p>
            )}
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .head {
    padding-bottom: 28px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--rule);
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: 36px;
    align-self: start;
    position: sticky;
    top: 84px;
  }
  .small-head {
    font-size: 1rem;
    margin: 0 0 12px;
    padding-left: 10px;
    border-left: 4px solid var(--accent);
  }
  .small-head .en {
    margin-left: 8px;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-muted);
  }
  .interests {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .interests li {
    padding: 8px 12px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    font-size: 0.95rem;
  }
  .labs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .lab {
    padding: 0;
    border: 0;
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .lab a {
    text-decoration: none;
  }
  .stats {
    display: flex;
    gap: 28px;
    margin: 0;
  }
  .stats dt {
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.1;
  }
  .stats dd {
    margin: 2px 0 0;
    color: var(--text-muted);
    font-size: 0.88rem;
  }
  .pubs {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    line-height: 1.5;
  }
  li:first-child {
    padding-top: 2px;
  }
  .idx {
    flex-shrink: 0;
    width: 3em;
    color: var(--text-muted);
    font-size: 0.85rem;
    padding-top: 2px;
  }
  .body {
    min-width: 0;
  }
  .title {
    font-weight: 600;
  }
  .authors,
  .venue {
    font-size: 0.92rem;
    color: var(--text-muted);
  }
  .authors strong {
    color: var(--text);
  }
  .note {
    margin-left: 8px;
    padding: 1px 8px;
    border-radius: 999px;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    font-style: normal;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-top: 4px;
    font-size: 0.82rem;
  }
  .empty {
    margin: 0;
    padding: 18px;
    border: 1px dashed var(--rule);
    border-radius: 8px;
    text-align: center;
  }
  @media (max-width: 900px) {
    .side {
      position: static;
    }
  }
</style>
