---
// 開放式課程總覽
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import CourseRows from '../../components/CourseRows.astro';
import { getCourseSummaries } from '../../utils/courses';

const courses = await getCourseSummaries();
---

<BaseLayout title="開放式課程" description="系列教材，一個單元一頁，從頭讀到尾或挑主題看都可以">
  <PageBanner
    title="開放式課程"
    en="Open Courses"
    subtitle={`系列教材，一個單元一頁 · ${courses.length} 門課`}
    photo="ICPC-台中區域賽"
  />
  <div class="list">
    <CourseRows courses={courses} />
  </div>
</BaseLayout>

<style>
  .list {
    max-width: 880px;
  }
</style>
