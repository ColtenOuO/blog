// Cloudflare Workers 部署設定：發布 Astro build 出來的靜態檔（dist/），
// 另外由 worker/index.ts 處理 /api/*（文章觀看次數，存在 D1）
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // 只有 /api/* 會先進 Worker，其他靜態頁面照舊直接由 assets 回應（不吃 Worker 額度）
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-views",
      "database_id": "bb522147-2ed6-4659-b237-e543fc0fb56a",
      "migrations_dir": "migrations"
    }
  ]
}
